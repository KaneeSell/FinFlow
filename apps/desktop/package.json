{
  "name": "@finflow/desktop",
  "version": "1.0.0",
  "private": true,
  "description": "FinFlow Desktop App (Windows & Linux)",
  "author": "Kane'e Sell <kanee.sell@gmail.com>",
  "homepage": "https://github.com/KaneeSell/FinFlow",
  "main": "./dist/main.js",
  "scripts": {
    "dev": "tsc -p tsconfig.json && electron .",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepare:api": "node scripts/prepare-api.mjs",
    "smoke:api": "node scripts/smoke-test-api.mjs",
    "package:win": "npm run build && npm run prepare:api && electron-builder --win --config electron-builder.yml --publish never",
    "package:linux": "npm run build && npm run prepare:api && electron-builder --linux --config electron-builder.yml --publish never"
  },
  "dependencies": {
    "electron-serve": "^1.3.0"
  },
  "devDependencies": {
    "electron": "^35.1.5",
    "electron-builder": "^25.1.8"
  }
}
